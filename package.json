{
  "name": "netpals",
  "productName": "Netpals",
  "version": "0.4.0",
  "description": "A 2003-style buddy list where the buddies are AI personas who message you through the day. Local-first.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "sounds": "node scripts/make-sounds.js",
    "check:llm": "node scripts/check-llm.js",
    "check:scheduler": "node tests/run.js scheduler",
    "reset-password": "node scripts/reset-password.js",
    "license": "node scripts/license.js",
    "check:license": "node tests/unit/license.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "check:models": "node scripts/check-models.js",
    "check:chat": "node scripts/check-chat.js",
    "test": "node tests/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.netpals.app",
    "productName": "Netpals",
    "files": [
      "main.js",
      "main/**",
      "preload.js",
      "lib/**",
      "ui/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Netpals",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp",
      "installerHeader": "build/header.bmp",
      "license": "LICENSE.txt",
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Netpals",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "DaveEuson",
      "repo": "netpals",
      "releaseType": "draft"
    }
  },
  "author": "DaveEuson"
}
